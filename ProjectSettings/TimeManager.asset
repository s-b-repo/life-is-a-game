%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!5 &1
TimeManager:
  m_ObjectHideFlags: 0
  # Fixed Timestep = 1/30 = 0.0333333 s → 30 Hz.
  # Chosen to match the lockstep tick rate defined in DetSim/TickClock.cs.
  # Do NOT change without also updating LockstepEngine tick alignment.
  Fixed Timestep: 0.0333333
  Maximum Allowed Timestep: 0.1
  m_TimeScale: 1
  Maximum Particle Timestep: 0.03
